rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── intakeTokens ─────────────────────────────────────
    // Created by authenticated clinicians.
    // Readable by anyone who knows the exact token ID.
    // Clinicians can create and fully update.
    // Unauthenticated patients can flip status to "completed" only.
    // Clinicians can delete their own tokens.
    match /intakeTokens/{tokenId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    || (request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['status'])
                        && request.resource.data.status == 'completed');
      allow delete: if request.auth != null
                    && resource.data.clinicianId == request.auth.uid;
    }

    // ── clinicianProfiles ────────────────────────────────
    // Readable by anyone — needed so the public patient intake page can
    // display the clinic name and clinician name (they already have the
    // clinicianId from the token, and UIDs are not guessable).
    // Writable only by the authenticated clinician who owns it.
    match /clinicianProfiles/{clinicianId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == clinicianId;
    }

    // ── pending_intakes ───────────────────────────────────
    // Written by the public patient intake flow (no auth required).
    // Readable only by the clinician whose uid matches clinicianId.
    // Clinician can update status to "reviewed" (no other field changes).
    // Clinician can delete their own intakes.
    match /pending_intakes/{docId} {
      allow create: if true;
      allow read: if request.auth != null
                  && resource.data.clinicianId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.clinicianId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'reviewed';
      allow delete: if request.auth != null
                    && resource.data.clinicianId == request.auth.uid;
    }

    // ── vanderbiltAssessments ─────────────────────────────
    // Created and read/updated/deleted by authenticated clinicians.
    // On CREATE request.resource.data has the new fields (no resource yet).
    // Best-effort updates from unauthenticated form submissions are also
    // allowed so parentStatus/teacherStatus sync back without blocking submit.
    match /vanderbiltAssessments/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.clinicianId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.clinicianId == request.auth.uid;
      allow update: if (request.auth != null
                        && resource.data.clinicianId == request.auth.uid)
                    || true; // best-effort sync from unauthenticated form submissions
      allow delete: if request.auth != null
                    && resource.data.clinicianId == request.auth.uid;
    }

    // ── vanderbiltParentForms ─────────────────────────────
    // Created by authenticated clinicians (via setDoc with token as doc ID).
    // Publicly readable by anyone who knows the token URL.
    // Updatable by anyone (unauthenticated parent completing the form).
    match /vanderbiltParentForms/{tokenId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true; // unauthenticated parent submits responses
      allow delete: if request.auth != null
                    && resource.data.clinicianId == request.auth.uid;
    }

    // ── vanderbiltTeacherForms ────────────────────────────
    // Same pattern as vanderbiltParentForms.
    match /vanderbiltTeacherForms/{tokenId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true; // unauthenticated teacher submits responses
      allow delete: if request.auth != null
                    && resource.data.clinicianId == request.auth.uid;
    }

  }
}
