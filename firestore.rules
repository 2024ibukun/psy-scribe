rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── intakeTokens ─────────────────────────────────────
    // Created by authenticated clinicians.
    // Readable by anyone who has the exact token document ID
    // (the token string itself acts as the access control).
    // Authenticated clinicians can do full updates.
    // Unauthenticated patients can only flip status to
    // "completed" — they already proved access by knowing
    // the token ID (which is unguessable).
    match /intakeTokens/{tokenId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    || (request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['status'])
                        && request.resource.data.status == 'completed');
      allow delete: if false;
    }

    // ── pending_intakes ───────────────────────────────────
    // Written by the public patient intake flow (no auth).
    // Readable only by the authenticated clinician whose uid
    // matches the clinicianId stored in the document.
    match /pending_intakes/{docId} {
      allow create: if true;
      allow read: if request.auth != null
                  && resource.data.clinicianId == request.auth.uid;
      allow update, delete: if false;
    }

  }
}
